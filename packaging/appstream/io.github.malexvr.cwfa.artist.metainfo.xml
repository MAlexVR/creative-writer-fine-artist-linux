<component type="desktop-application">
  <id>io.github.malexvr.cwfa.artist</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Fine Artist</name>
  <summary>Run the 1990s children's painting program on Linux</summary>
  <description>
    <p>
      A native Linux runtime for Fine Artist, the 1990s Windows 3.1 painting program for children. It loads your original
      program files and runs them without Wine and without Windows.
    </p>
    <p>
      This package contains no Microsoft software. You need your own copy of the CD (or its disc image),
      English or Spanish; the first start asks where it is and remembers it. Your users and documents are kept in
      ~/.local/share/cwfa/data, and printing saves PDF files in your Documents folder.
    </p>
  </description>
  <launchable type="desktop-id">cwfa-artist.desktop</launchable>
  <icon type="stock">cwfa-artist</icon>
  <screenshots>
    <screenshot type="default">
      <caption>Fine Artist running natively</caption>
      <image type="source">https://raw.githubusercontent.com/MAlexVR/creative-writer-fine-artist-linux/main/docs/screenshots/artist-07-studio.png</image>
